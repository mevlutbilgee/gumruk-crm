# mock  -> tarayıcıda localStorage + hayali veri (varsayılan)
# supabase -> gerçek Supabase bağlantısı
VITE_DATA_MODE=mock
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Demo modunda admin şifresinin özeti (SHA-256). Üretmek için:
#   npm run hash-password -- <admin-e-postası> <şifre>
VITE_ADMIN_PASSWORD_HASH=
